"""FastAPI application – exposes the /ask endpoint."""
from __future__ import annotations

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

from pipeline.question_analysis import analyse_question
from pipeline.search import web_search
from scraper.scraper import scrape_urls
from scraper.cleaner import clean_text
from pipeline.chunker import chunk_text
from pipeline.embedder import embed_chunks
from pipeline.vector_store import VectorStore
from pipeline.llm import generate_answer

app = FastAPI(title="RAG Search Engine", version="1.0.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

store = VectorStore()


class AskRequest(BaseModel):
    question: str


class AskResponse(BaseModel):
    answer: str
    sources: list[str]
    pipeline_trace: dict


@app.get("/health")
async def health():
    return {"status": "ok"}


@app.post("/ask", response_model=AskResponse)
async def ask(req: AskRequest):
    question = req.question.strip()
    if not question:
        raise HTTPException(status_code=400, detail="Question cannot be empty.")

    trace: dict = {}

    # ── 1. Question Analysis ───────────────────────────────────────────────
    analysis = analyse_question(question)
    trace["analysis"] = analysis

    # ── 2. Web Search ─────────────────────────────────────────────────────
    urls = await web_search(analysis["queries"])
    trace["urls_found"] = len(urls)

    # ── 3. Web Scraping ───────────────────────────────────────────────────
    raw_pages = await scrape_urls(urls)
    trace["pages_scraped"] = len(raw_pages)

    # ── 4. Text Cleaning ──────────────────────────────────────────────────
    cleaned = {url: clean_text(html) for url, html in raw_pages.items()}
    trace["total_chars"] = sum(len(t) for t in cleaned.values())

    # ── 5. Chunking ───────────────────────────────────────────────────────
    all_chunks: list[dict] = []
    for url, text in cleaned.items():
        for chunk in chunk_text(text):
            all_chunks.append({"text": chunk, "source": url})
    trace["chunks"] = len(all_chunks)

    # ── 6. Embed & Upsert ─────────────────────────────────────────────────
    embedded = await embed_chunks(all_chunks)
    store.upsert(embedded)

    # ── 7. Semantic Retrieval ─────────────────────────────────────────────
    results = store.query(question)
    trace["retrieved"] = len(results)

    # ── 8. LLM Answer ─────────────────────────────────────────────────────
    answer = await generate_answer(question, results)
    sources = list({r["source"] for r in results})

    return AskResponse(answer=answer, sources=sources, pipeline_trace=trace)
